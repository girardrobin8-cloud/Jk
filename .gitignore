node_modules
dist
build
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Rushes filmés : média source, hors dépôt (les remettre dans public/rushes/)
public/rushes/*.mp4
public/voix/*.mp4

# Épisodes : le texte et les plans sont versionnés, les médias non.
# Tout se régénère depuis brief.json, song_plan.json et timeline.json.
episodes/*/song.mp3
episodes/*/final.mp4
episodes/*/thumbnail.png
episodes/*/images/*
episodes/*/clips/*
!episodes/*/images/.gitkeep
!episodes/*/clips/.gitkeep
