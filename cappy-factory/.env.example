# Modèle de configuration. Copier en .env, remplir, ne jamais commiter.
#
#     cp cappy-factory/.env.example cappy-factory/.env
#
# .env est ignoré par git (règle « .env » à la racine du dépôt, valable à tous
# les niveaux). Les valeurs ci-dessous sont vides exprès : une clé écrite ici
# finirait dans l'historique.

# --- Utilisée par le code existant -----------------------------------------

# Voix off ElevenLabs, lue par scripts/voixoff.py.
ELEVENLABS_API_KEY=

# --- Fournisseurs à choisir -------------------------------------------------
# Aucune de ces clés n'est encore lue par un script : elles nomment les postes
# de la chaîne, pas des décisions prises. À supprimer si le poste passe par un
# connecteur plutôt que par une clé.

# La chanson, 60 s, anglais, pop acoustique.
SONG_API_KEY=

# Les images des douze plans, puis leur mise en mouvement.
HIGGSFIELD_API_KEY=

# La publication YouTube, si elle est automatisée un jour.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
